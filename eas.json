{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "https://api-dev.rounddacornerapp.com",
        "API_PREFIX": "/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "API_URL": "https://api-dev.rounddacornerapp.com",
        "API_PREFIX": "/api/v1"
      },
      "ios": {
        "buildConfiguration": "DevRelease"
      }
    },
    "testflight": {
      "autoIncrement": false,
      "env": {
        "API_URL": "https://api.rounddacornerapp.com",
        "API_PREFIX": "/api/v1",
        "APP_ENV": "production"
      },
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "API_URL": "https://api.rounddacornerapp.com",
        "API_PREFIX": "/api/v1"
      },
        "android": {
          "gradleCommand": ":app:bundleLiveGoogleRelease"
        },
      "ios": {
        "image": "latest",
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
